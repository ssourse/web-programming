<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Лабораторная № 6 — защищённая библиотека</display-name>

    <!-- Сама форма index.jsp доступна без входа; результат защищён. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Список книг</web-resource-name>
            <url-pattern>/BookList.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>lab6reader</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>Lab6 Local Library</realm-name>
    </login-config>
    <security-role>
        <role-name>lab6reader</role-name>
    </security-role>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
