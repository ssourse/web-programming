<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Формат модели проекта -->
    <modelVersion>4.0.0</modelVersion>
    <!-- Координаты артефакта: автор, имя, версия -->
    <groupId>ru.etu</groupId>
    <artifactId>lab2</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging> <!-- Сборка web-приложения -->
    <properties>
        <!-- Компиляция под установленную JDK 8 -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <!-- dependencies не нужны: JSP исполняет Tomcat 9 -->
    <build>
        <finalName>lab2</finalName> <!-- target/lab2.war -->
        <plugins>
            <!-- Clean: очистка каталога target -->
            <plugin><artifactId>maven-clean-plugin</artifactId><version>3.2.0</version></plugin>
            <!-- Compiler: компиляция Java для JDK 8 -->
            <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.11.0</version></plugin>
            <!-- Resources: копирование ресурсов -->
            <plugin><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
            <!-- Упаковка JSP, web.xml, cat.gif в WAR -->
            <plugin><artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <!-- Install: размещение WAR в локальном .m2/repository -->
            <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.2</version></plugin>
        </plugins>
    </build>
</project>
