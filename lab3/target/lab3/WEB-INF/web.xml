<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Лабораторная работа 3 — Сервлеты</display-name>
    <servlet>
        <servlet-name>BooksList</servlet-name>
        <servlet-class>ru.etu.lab3.BooksListServlet</servlet-class>
        <!-- Статический параметр инициализации -->
        <init-param>
            <param-name>libraryTitle</param-name>
            <param-value>Домашняя библиотека</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>BooksList</servlet-name>
        <url-pattern>/BooksList</url-pattern>
    </servlet-mapping>
    <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
