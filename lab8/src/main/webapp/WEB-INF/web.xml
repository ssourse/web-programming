<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>Лабораторная 8 — GWT</display-name>
  <servlet>
    <servlet-name>GreetingService</servlet-name>
    <servlet-class>ru.etu.lab8.server.GreetingServiceImpl</servlet-class>
  </servlet>
  <!-- URL relative to GWT module base /lab8/bookmodule/ -->
  <servlet-mapping>
    <servlet-name>GreetingService</servlet-name>
    <url-pattern>/bookmodule/greet</url-pattern>
  </servlet-mapping>
  <welcome-file-list><welcome-file>BookModule.html</welcome-file></welcome-file-list>
</web-app>
